CORPUS_SNAPSHOT_DATE=2026-09-27

# Embeddings: hosted Hugging Face for Render; "local" keeps on-device MiniLM.
# Or an OpenAI-compatible model name, e.g. text-embedding-3-small (needs LLM_API_KEY).
# Changing EMBED_MODEL requires re-running: python scripts/ingest.py
EMBED_MODEL=hf:BAAI/bge-small-en-v1.5
HF_TOKEN=
HF_EMBED_TIMEOUT_SECONDS=60

# Optional Anthropic provider. Leave empty to use Groq directly.
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-sonnet-5-5

# Fallback provider (Groq). Used when Anthropic is exhausted. Never commit a real key.
GROQ_API_KEY=gsk-your-key-here
GROQ_CHAT_MODEL=openai/gpt-oss-20b

# Only needed if EMBED_MODEL is an OpenAI-compatible model name.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1

RETRIEVAL_SCORE_THRESHOLD=0.70
ALLOWED_HOSTS=hdfcfund.com,amfiindia.com,sebi.gov.in
